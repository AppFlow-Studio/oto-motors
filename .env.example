# ─────────────────────────────────────────────────────────────
#  OTO Motors — environment variables
#  Copy this file to `.env` (or `.env.local`) and fill in values.
#  Never commit real secrets — `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Build Your Deal lead routing ---
# Where new lead notifications are delivered (your monitored inbox)
LEAD_TO_EMAIL=sales@exoticautoleasing.com

# From address. The domain (exoticautoleasing.com) must be verified
# in Resend → Domains before mail will send.
LEAD_FROM_EMAIL=OTO Motors <deals@exoticautoleasing.com>

# Optional: silent BCC copy of every lead (leave blank to disable)
LEAD_BCC_EMAIL=

# --- Address autocomplete (Google Places) ---
# Public browser key for the Build Your Deal "Delivery location" field.
# In Google Cloud: enable "Places API (New)", then restrict the key by
# HTTP referrer (your domains). Safe to expose — it is client-side by design.
# Leave blank to fall back to a plain text input.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
